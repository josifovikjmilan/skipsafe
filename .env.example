# Copy this file to .env.local and fill in the two public values from
# Supabase: Connect (or Project Settings -> API Keys).
# Never put the secret key (sb_secret_... or service_role) here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
